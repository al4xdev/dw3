[submodule "psxstack"]
	path = psxstack
	# The fork, not upstream: this port's renderer, audio and signal work are commits that only exist here (upstream is
	# 36 commits behind). Upstream is still there as the `origin` remote of the submodule. Named after the port so the two
	# repositories read as one project: dw3 (the port) and dw3-psxstack (the runtime it runs on).
	url = https://github.com/al4xdev/dw3-psxstack.git
	branch = dw3-handheld
